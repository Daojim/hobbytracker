{
  "ConnectionStrings": {
    // Set per environment. Development uses appsettings.Development.json, which points at
    // the docker-compose database at the repo root.
    "HobbyTracker": ""
  },
  "Igdb": {
    // ClientId and ClientSecret are intentionally absent: they are secrets and live in
    // dotnet user-secrets locally, or environment variables in a deployed environment.
    //   dotnet user-secrets set "Igdb:ClientId" "..."     --project backend
    //   dotnet user-secrets set "Igdb:ClientSecret" "..." --project backend
    // Startup fails with a named error if either is missing.
    "BaseUrl": "https://api.igdb.com/v4/",
    "TokenUrl": "https://id.twitch.tv/oauth2/token",
    "DefaultSearchLimit": 20,
    "RequestTimeoutSeconds": 15
  },
  "Tmdb": {
    // AccessToken is intentionally absent: it is a secret and lives in dotnet user-secrets
    // locally, or an environment variable in a deployed environment.
    //   dotnet user-secrets set "Tmdb:AccessToken" "..." --project backend/src/HobbyTracker.Api
    // It is TMDB's v4 read access token, from https://www.themoviedb.org/settings/api — one
    // static bearer with no handshake and no expiry, which is why there is no auth handler
    // where IGDB needs one. Startup fails with a named error if it is missing.
    "BaseUrl": "https://api.themoviedb.org/3/",
    // Where posters are served from, and at what width. TMDB publishes both from /configuration
    // and reserves the right to move them, so they are settings rather than constants — the
    // reasoning Igdb:BaseUrl already has. w342 is the rung above what a card needs at its
    // widest, so a poster is never upscaled.
    "ImageBaseUrl": "https://image.tmdb.org/t/p/",
    "PosterSize": "w342",
    // TMDB pages at twenty and takes no count of its own, so this is applied to what comes back.
    "DefaultSearchLimit": 20,
    "RequestTimeoutSeconds": 15
  },
  "OpenCritic": {
    // ApiKey is intentionally absent: it is a secret and lives in dotnet user-secrets locally, or
    // OpenCritic__ApiKey in a deployed environment, from OPENCRITIC_API_KEY in the server's .env.
    //   dotnet user-secrets set "OpenCritic:ApiKey" "..." --project backend/src/HobbyTracker.Api
    // OPTIONAL, unlike every other credential here: without it nothing is asked of OpenCritic and
    // the journal shows OpenCritic's link alone, so the app boots without one. It is a RapidAPI
    // key, from https://rapidapi.com/opencritic-opencritic-default/api/opencritic-api — the free
    // plan is 200 requests a day, and this app never searches.
    "BaseUrl": "https://opencritic-api.p.rapidapi.com/",
    // What RapidAPI is told the request is for, which stays the same when BaseUrl points at a stub.
    "Host": "opencritic-api.p.rapidapi.com",
    "RequestTimeoutSeconds": 15
  },
  "Steam": {
    // Keyless: IUserReviewsService/GetAppReviews answers without one, sharing a rate limit with
    // every other keyless caller. Every value is a working default.
    "BaseUrl": "https://api.steampowered.com/",
    "RequestTimeoutSeconds": 15
  },
  "Wikidata": {
    // Keyless and read-only: how a game's OpenCritic page is found, from IGDB's slug, with no
    // matching. Wikimedia asks every program reading its query service to name itself.
    "Endpoint": "https://query.wikidata.org/sparql",
    "UserAgent": "HobbyTracker/1.0 (a personal hobby journal)",
    "RequestTimeoutSeconds": 15
  },
  "Reviews": {
    // The journal's OpenCritic and Steam rows. A game found to have no page is looked for again
    // after this many days, as HowLongToBeat re-asks; a page found is never looked for again.
    "RecheckAfterDays": 30,
    // What each page says is kept this long under the provider's own id, and asked again on a new
    // journal day regardless. OpenCritic's free plan is 200 requests a day.
    "KeepVerdictsHours": 24
  },
  "Hltb": {
    // HowLongToBeat has no API and no account, so there are no secrets here — every value below
    // is a default that already works, and this block exists to say which knobs there are.
    "BaseUrl": "https://howlongtobeat.com/",
    "RequestTimeoutSeconds": 15,
    // The search endpoint's name is scraped out of the site's own JavaScript. It has changed
    // twice already — s, then seek, then bleed — so this is where to correct the next rename
    // without a release, on the day the scrape stops finding it.
    "FallbackSearchPath": "search/site",
    // Politeness rather than compliance: HLTB publishes no rate limit. See HltbThrottle.
    "MinSecondsBetweenRequests": 2,
    "RecheckAfterDays": 30,
    // Measured against a real library: every correct match scored 1.0 and the closest wrong one
    // scored 0.64, so 0.9 has room to spare. The margin is what refuses a title HLTB lists twice
    // — "Resident Evil 4" is there for 2005 and for 2023 — rather than settling it on a coin flip.
    "MatchThreshold": 0.9,
    "AmbiguityMargin": 0.05,
    // The kill switch, for when HLTB breaks unofficial clients again.
    "Enabled": true
  },
  "HltbBackfill": {
    // The HowLongToBeat backfill, once a day: every title on a board never asked about, or last
    // asked more than Hltb:RecheckAfterDays ago, is queued for the worker. So a game matched
    // before it came out, with no times yet, catches up within a month without anybody asking.
    // Every value is a working default; the block exists to say which knobs there are.
    "IntervalHours": 24,
    // Not nought: the first tick would otherwise race the migration the host runs at startup.
    "StartupDelayMinutes": 5,
    // Off in appsettings.Development.json, so that a local run is not traffic. Hltb:Enabled
    // above stops this as well.
    "Enabled": true
  },
  "ReleaseRefresh": {
    // The release calendar's nightly sweep, and the only traffic this app generates that nobody
    // asked for. Every value is a working default; the block exists to say which knobs there are.
    //
    // An interval rather than a time of day, deliberately: "daily" need not mean 3am Eastern, and
    // keeping the journal zone out of the worker keeps the count in docs/data-model.md honest.
    "IntervalHours": 24,
    // Not nought: the first tick would otherwise race the migration the host runs at startup.
    "StartupDelayMinutes": 5,
    // The kill switch. IGDB allows four requests a second and this is the one thing here that
    // asks without being asked, so turning it off should not need a release.
    "Enabled": true
  },
  "Auth": {
    // Google's ClientId and ClientSecret are intentionally absent for the reason IGDB's are:
    // they are secrets and live in dotnet user-secrets locally, or environment variables in a
    // deployed environment. Register the app at https://console.cloud.google.com/apis/credentials
    // with http://localhost:5173/api/auth/google/callback as an authorised redirect URI.
    //   dotnet user-secrets set "Auth:Google:ClientId" "..."     --project backend/src/HobbyTracker.Api
    //   dotnet user-secrets set "Auth:Google:ClientSecret" "..." --project backend/src/HobbyTracker.Api
    // Discord is the same, from https://discord.com/developers/applications:
    //   dotnet user-secrets set "Auth:Discord:ClientId" "..."     --project backend/src/HobbyTracker.Api
    //   dotnet user-secrets set "Auth:Discord:ClientSecret" "..." --project backend/src/HobbyTracker.Api
    // Startup fails with a named error if either is missing.
    //
    // The three endpoints are settings rather than constants so the end-to-end suite can point
    // the real handler at a local stub, exactly as Igdb:BaseUrl does.
    "Google": {
      "AuthorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
      "TokenEndpoint": "https://oauth2.googleapis.com/token",
      "UserInfoEndpoint": "https://openidconnect.googleapis.com/v1/userinfo"
    },
    "Discord": {
      "AuthorizationEndpoint": "https://discord.com/oauth2/authorize",
      "TokenEndpoint": "https://discord.com/api/oauth2/token",
      "UserInfoEndpoint": "https://discord.com/api/users/@me"
    },
    // Sliding, so using the app renews it and only a month away from it signs you out.
    "SessionDays": 30
  },
  "Journal": {
    // The zone the journal records days in. An IANA id, so daylight saving is handled for us:
    // Eastern is UTC-4 in summer and UTC-5 in winter, and a fixed offset would be wrong for one
    // of those halves. UTC would be wrong every evening after 8pm.
    "TimeZone": "America/New_York"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
