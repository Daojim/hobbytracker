{
  "ConnectionStrings": {
    // Matches docker-compose.yml at the repo root. Local throwaway container, so these
    // credentials are not a secret — real ones never belong in this file.
    "HobbyTracker": "Host=localhost;Port=5432;Database=hobbytracker;Username=admin;Password=password"
  },
  "HltbBackfill": {
    // Off on a development machine: somebody running the app to look at the board should not
    // become traffic to HowLongToBeat. Adding a title still asks about it, and the journal's
    // arrow still asks again; only the asking nobody asked for stops. See HltbBackfillOptions.
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Shows the APIcalypse query being sent, and the SQL EF generates for the upsert.
      "HobbyTracker.Api": "Debug"
    }
  }
}
