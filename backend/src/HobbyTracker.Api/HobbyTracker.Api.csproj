<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HobbyTracker.Api</RootNamespace>
    <AssemblyName>HobbyTracker.Api</AssemblyName>
    <!-- IGDB client id/secret are read from user-secrets in Development; see CLAUDE.md. -->
    <UserSecretsId>d32050b3-664c-452e-8f85-a6d84465659a</UserSecretsId>
  </PropertyGroup>

  <!-- Versions live in backend/Directory.Packages.props. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <!-- Design-time only: powers `dotnet ef migrations`. PrivateAssets keeps it out of the published output. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
