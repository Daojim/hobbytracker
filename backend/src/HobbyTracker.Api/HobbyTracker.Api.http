@HobbyTracker.Api_HostAddress = http://localhost:5201

### Search IGDB for games by title.
# Hits IGDB, upserts every result into media + games, returns them in relevance order.
# Run it twice and the row count will not change — see the upsert note in CLAUDE.md.
GET {{HobbyTracker.Api_HostAddress}}/api/games?search=halo
Accept: application/json

### Same search, capped to five results.
GET {{HobbyTracker.Api_HostAddress}}/api/games?search=hollow%20knight&limit=5
Accept: application/json

### A title with no IGDB match — expect 200 and an empty array, not a 404.
GET {{HobbyTracker.Api_HostAddress}}/api/games?search=zzzzzzzznotarealgame
Accept: application/json

### Missing search term — expect 400 with a ValidationProblemDetails body.
GET {{HobbyTracker.Api_HostAddress}}/api/games
Accept: application/json

### One stored game with everything logged against it. Use an id from a search above.
GET {{HobbyTracker.Api_HostAddress}}/api/games/1
Accept: application/json

### ---------------------------------------------------------------- log entries

### Start playing something. mediaId must be a game already in the catalog.
POST {{HobbyTracker.Api_HostAddress}}/api/log-entries
Content-Type: application/json

{
  "mediaId": 1,
  "status": "InProgress",
  "startedAt": "2026-08-01"
}

### Log a finished playthrough with a rating.
POST {{HobbyTracker.Api_HostAddress}}/api/log-entries
Content-Type: application/json

{
  "mediaId": 1,
  "status": "Completed",
  "rating": 9.6,
  "platform": "Switch",
  "startedAt": "2026-07-02",
  "completedAt": "2026-08-19"
}

### Rejected: numeric(3,1) would silently round 8.75 to 8.8, so 400 rather than lie.
POST {{HobbyTracker.Api_HostAddress}}/api/log-entries
Content-Type: application/json

{ "mediaId": 1, "status": "Completed", "rating": 8.75 }

### Rejected: a completion cannot precede its own start.
POST {{HobbyTracker.Api_HostAddress}}/api/log-entries
Content-Type: application/json

{
  "mediaId": 1,
  "status": "Completed",
  "startedAt": "2026-08-20",
  "completedAt": "2026-07-01"
}

### The whole journal, most recently recorded first.
GET {{HobbyTracker.Api_HostAddress}}/api/log-entries
Accept: application/json

### Filtered and paged.
GET {{HobbyTracker.Api_HostAddress}}/api/log-entries?status=Completed&page=1&pageSize=10
Accept: application/json

### Replace an entry outright. Fields left out of the body are CLEARED, not preserved.
PUT {{HobbyTracker.Api_HostAddress}}/api/log-entries/1
Content-Type: application/json

{
  "status": "Completed",
  "rating": 10.0,
  "completedAt": "2026-08-20"
}

### Remove an entry. The game stays in the catalog.
DELETE {{HobbyTracker.Api_HostAddress}}/api/log-entries/1

### -------------------------------------------------------------------- library

### Your collection: titles you have logged, not everything a search happened to cache.
GET {{HobbyTracker.Api_HostAddress}}/api/library
Accept: application/json

### Filtered on the CURRENT status — a game completed in 2024 and being replayed now
### appears under InProgress, not Completed.
GET {{HobbyTracker.Api_HostAddress}}/api/library?hobby=games&status=InProgress
Accept: application/json

### OpenAPI document (Development only).
GET {{HobbyTracker.Api_HostAddress}}/openapi/v1.json

### Write a note against a pass. An append, never an overwrite — that is the whole point.
POST {{HobbyTracker.Api_HostAddress}}/api/log-entries/1/notes
Content-Type: application/json

{
  "body": "finally beat radiance"
}

### Fix a typo in one. Its date does not move.
PUT {{HobbyTracker.Api_HostAddress}}/api/notes/1
Content-Type: application/json

{
  "body": "finally beat the Radiance"
}

### Take one back.
DELETE {{HobbyTracker.Api_HostAddress}}/api/notes/1
