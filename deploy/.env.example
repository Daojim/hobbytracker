# Copy this beside compose.yml, fill it in, and lock it down:
#
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored. Nothing in it belongs in the repository, in a commit message, or pasted
# into a chat window.

# ------------------------------------------------------------- the public address
# What the outside world reaches this at: scheme and host, no path and no trailing slash.
#
# Register exactly this plus /api/auth/google/callback and /api/auth/discord/callback as
# authorised redirect URIs on both provider apps. A mismatch is a sign-in refused by the
# provider, on the provider's own error page, which this app never sees and cannot report.
PUBLIC_ORIGIN=https://hobbytracker.example
ALLOWED_HOSTS=hobbytracker.example

# -------------------------------------------------------------------- the database
# Any long random string -- nothing outside this compose project ever sees it, because the
# database publishes no port at all.
POSTGRES_PASSWORD=

# --------------------------------------------------------------------------- IGDB
# Twitch credentials. Register an application at https://dev.twitch.tv/console/apps.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ------------------------------------------------------------------------ sign-in
# Both providers are required: the app refuses to boot without either, naming the missing key.
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ------------------------------------------------------------------------- backups
# Somewhere on a DIFFERENT physical disk from the one holding pgdata. A backup that dies with
# the disk it was protecting against is not a backup.
BACKUP_DIR=
BACKUP_RETAIN_DAYS=14

# -------------------------------------------------------------------------- the tunnel
# From the Cloudflare Zero Trust dashboard. Only read when the `tunnel` profile is used, so it
# can stay empty right up until the app is meant to be public.
TUNNEL_TOKEN=

# ------------------------------------------------------------------------- layout
# Where the clone and the data sit, relative to this file. The defaults suit a directory holding
# compose.yml, the clone in app/, and pgdata/ and dpkeys/ beside them. APP_UID/APP_GID must own
# dpkeys/, or the session keys are held in memory and every restart signs everybody out.
#APP_ROOT=./app
#DATA_ROOT=.
#APP_UID=1000
#APP_GID=1000
#DEBUG_PORT=8081
